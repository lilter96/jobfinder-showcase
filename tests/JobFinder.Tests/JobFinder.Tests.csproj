<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
    <PropertyGroup>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="RichardSzalay.MockHttp" Version="7.1.0" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <!-- *IntegrationTests: a throwaway Postgres (skipped when Docker is not available). -->
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.41.0" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.41.0" />
        <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.41.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\JobFinder.App\JobFinder.App.csproj" />
        <ProjectReference Include="..\JobFinder.MessagingProbe\JobFinder.MessagingProbe.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Trimmed real pages (hh.ru / rabota.by / Habr, captured 2026-09-26) and the real prompts. -->
        <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\config\appsettings.json" Link="config\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\prompts\*.md;..\..\prompts\*.json" Link="prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="CopyMessagingProbeHost" AfterTargets="Build">
        <Copy SourceFiles="$(MSBuildProjectDirectory)/../JobFinder.MessagingProbe/bin/$(Configuration)/$(TargetFramework)/JobFinder.MessagingProbe.runtimeconfig.json;$(MSBuildProjectDirectory)/../JobFinder.MessagingProbe/bin/$(Configuration)/$(TargetFramework)/JobFinder.MessagingProbe.deps.json" DestinationFolder="$(TargetDir)" />
    </Target>

</Project>
